<?xml version="1.0" encoding="UTF-8"?>
<!-- Indicizzazione all'avvio del Mac. Un solo giro, incrementale: rifà solo
     ciò che è cambiato. Attende fino a 3 minuti che Ollama sia pronto. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.rayrag-indicizzatore</string>
    <key>ProgramArguments</key>
    <array>
        <string>__RADICE__/.venv/bin/python</string>
        <string>__RADICE__/indicizzatore/indicizza.py</string>
        <string>--attendi-ollama</string>
        <string>180</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__CASA__/.rayrag/indicizzazione.log</string>
    <key>StandardErrorPath</key>
    <string>__CASA__/.rayrag/indicizzazione.log</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>5</integer>
</dict>
</plist>
