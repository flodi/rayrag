# Cartelle da non indicizzare mai. Sintassi gitignore semplificata:
# '#' commento, '/' finale = solo cartelle, '*' glob sul nome.
#
# Il motivo per cui questo file esiste: un backup completo di un sito WordPress
# dentro la cartella dei documenti valeva oltre 1200 file di codice e boilerplate.
# Un indice pieno di license.txt di plugin non aiuta a trovare un contratto.

# backup e installazioni web
wp-admin/
wp-includes/
wp-content/
public_html/
public_html 2/

# dipendenze e build
node_modules/
vendor/
.venv/
venv/
__pycache__/
.build/
DerivedData/
Pods/

# controllo versione e cache
.git/
.svn/
.hg/
.cache/
Caches/
.Trash/

# roba di sistema
Library/
*.app/
